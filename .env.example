# --- Hostinger mail (sending) ---
HOSTINGER_EMAIL=you@yourdomain.com
HOSTINGER_PASSWORD=your-mailbox-password
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465

# --- Telegram control bot ---
TELEGRAM_BOT_TOKEN=123456789:AA...your-bot-token
TELEGRAM_CHAT_ID=123456789

# --- Vapi ---
VAPI_WEBHOOK_SECRET=change-this-to-a-random-string
VAPI_API_KEY=your-vapi-private-key
VAPI_ASSISTANT_ID=your-assistant-id
VAPI_PHONE_NUMBER_ID=your-phone-number-id
ZOOM_MEETING_LINK=https://zoom.us/j/yourpersonalroom

# --- Twilio (SMS fallback nudge, toll-free number) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_TOLLFREE_NUMBER=+18005551234

# --- Redial cron ---
CRON_SECRET=change-this-to-another-random-string

# --- Dashboard ---
# Required. Without this the /dashboard and /api/* routes refuse to serve data.
# Access your dashboard at: https://<your-app>/dashboard?key=<this value>
DASHBOARD_KEY=change-this-to-a-third-random-string

# --- Server ---
PORT=3000
